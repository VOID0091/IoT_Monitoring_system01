[Unit]
Description=IoT Monitor Device Agent
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/iot-agent
ExecStart=/opt/iot-agent/venv/bin/python /opt/iot-agent/agent.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=iot-agent

[Install]
WantedBy=multi-user.target
